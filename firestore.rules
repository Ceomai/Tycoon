rules_version = '2';
// Tapu güvenlik kuralları
// - saves/{uid}: yalnızca sahibi okur/yazar (bulut kaydı, ~1 MB sınırı)
// - lb/{hafta}_{uid}: lig skorları; oturum açmış herkes okur, kimse doğrudan yazamaz → yalnızca submitScore fonksiyonu
// - users, codes, invites, groups, rewards: yalnızca sunucu (Admin SDK kuralları atlar)
service cloud.firestore {
  match /databases/{db}/documents {
    match /saves/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['j', 'savedAt', 'earned', 'v'])
        && request.resource.data.j is string && request.resource.data.j.size() < 950000
        && request.resource.data.savedAt is number && request.resource.data.earned is number;
    }
    match /lb/{id} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
