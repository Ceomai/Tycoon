# Bu dosyayı .env olarak kopyalayıp doldurun. .env git'e girmez.
# Boş bırakılan servisler devre dışı kalır; oyun yerel çalışmaya devam eder.

# Firebase (Konsol → Proje ayarları → Web uygulaması)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_REGION=europe-west1

# AdMob reklam birimleri (boşsa ve VITE_ADMOB_TESTING=true ise Google test reklamları)
VITE_ADMOB_REWARDED_ANDROID=
VITE_ADMOB_REWARDED_IOS=
VITE_ADMOB_INTERSTITIAL_ANDROID=
VITE_ADMOB_INTERSTITIAL_IOS=
# Yayında mutlaka false
VITE_ADMOB_TESTING=true

# RevenueCat herkese açık SDK anahtarları
VITE_REVENUECAT_ANDROID=
VITE_REVENUECAT_IOS=

# Yayınlanmış gizlilik politikası ve kullanım koşulları adresleri
VITE_PRIVACY_URL=
VITE_TERMS_URL=
