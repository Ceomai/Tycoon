{
  "name": "tapu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Tapu: şantiyeden plazaya emlak oyunu (mobil)",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "build:preview": "vite build --mode preview && node scripts/make-fragment.mjs",
    "test:unit": "vitest run",
    "test:e2e": "vite build --mode preview && node tests/qa.cjs",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "sim": "rolldown -c scripts/rolldown.sim.mjs && node node_modules/.cache/tapu-sim.mjs",
    "cap:sync": "vite build && cap sync",
    "android": "vite build && cap sync android && cap open android",
    "ios": "vite build && cap sync ios && cap open ios",
    "icons": "capacitor-assets generate",
    "test:audit": "vite build --mode preview && node tests/audit.cjs",
    "test:gelir": "vite build --mode preview && node tests/gelir.cjs",
    "test:yerel": "vite build --mode preview && node tests/yerel.cjs",
    "i18n": "node scripts/i18n-extract.mjs && node scripts/i18n-build.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "8.2.1",
    "@capacitor-firebase/analytics": "8.5.2",
    "@capacitor-firebase/authentication": "8.5.2",
    "@capacitor-firebase/crashlytics": "8.5.2",
    "@capacitor-firebase/remote-config": "8.5.2",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "7.0.4",
    "@capacitor/screen-orientation": "8.0.2",
    "@capacitor/share": "8.0.3",
    "@capacitor/text-zoom": "8.0.1",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@revenuecat/purchases-capacitor": "13.7.4",
    "firebase": "12.19.0"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.5.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
